# Python / virtual env
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Scratch / lock files
.*.lock
.~lock*

# Large scratch model files (regenerable, and >100MB rejected by GitHub)
ipynb files/random_forestfinal_model.pkl
ipynb files/random_forest_balanced_loan_default.pkl
